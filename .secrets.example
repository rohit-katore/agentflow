# Copy to .secrets for local development with the nhost CLI.
# The first four are the standard nhost secrets; any random values work locally.
HASURA_GRAPHQL_ADMIN_SECRET = 'nhost-admin-secret'
HASURA_GRAPHQL_JWT_SECRET = '0f987876650b4a085e64594fae9219e7781b17506bec02489ad061fba8cb22db'
NHOST_WEBHOOK_SECRET = 'nhost-webhook-secret'
GRAFANA_ADMIN_PASSWORD = 'grafana-admin-password'

# LLM provider for llm_call steps (free tier: https://console.groq.com).
# Leave empty to run with the disclosed stub (1.2s artificial delay).
GROQ_API_KEY = ''

# Optional: incoming webhook URL for notify steps. Empty = notifications are logged.
SLACK_WEBHOOK_URL = ''
