# Copy to .env.local and fill in your nhost project values.
# For nhost Cloud these come from the project dashboard:
NEXT_PUBLIC_NHOST_SUBDOMAIN=local
NEXT_PUBLIC_NHOST_REGION=

# Optional explicit override, mostly useful with the local `nhost up` stack:
# NEXT_PUBLIC_NHOST_GRAPHQL_URL=https://local.graphql.local.nhost.run/v1
